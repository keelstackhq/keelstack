---
import { canonicalUrl } from "../lib/site";

interface Props {
  title: string;
  description: string;
  /** False for pages that must not claim a canonical URL, such as the 404 page. */
  canonical?: boolean;
}
import "@fontsource-variable/archivo/wdth.css";
import "@fontsource/jetbrains-mono/latin-400.css";
import "@fontsource/jetbrains-mono/latin-600.css";
import "@cascivo/themes/light.css";
import "../styles/tokens.css";
import "../styles/global.css";

const { title, description, canonical = true } = Astro.props;
const url = canonical ? canonicalUrl(Astro.url.pathname) : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {url && <link rel="canonical" href={url} />}
    {url && <meta property="og:url" content={url} />}
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' fill='%238DF0C8'/%3E%3Crect x='38' y='38' width='24' height='24' fill='%2315161A' transform='rotate(45 50 50)'/%3E%3C/svg%3E"
    />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
