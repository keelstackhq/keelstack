---
import { sections, split } from "../data/content";
import SectionHead from "./SectionHead.astro";
---

<section class="split">
  <SectionHead label={sections.split.label} heading={sections.split.heading} maxWidth="860px" />
  <div class="grid">
    <div class="handles">
      <div class="row">
        <div class="title">keelstack handles</div>
        <div class="note">kept current for you</div>
      </div>
      <div class="chips">
        {split.handles.map((h) => <span>{h}</span>)}
      </div>
    </div>
    <div class="yours">
      <div class="row">
        <div class="title">You write</div>
        <div class="note">never overwritten</div>
      </div>
      <div class="big">The logic.</div>
      <div class="text">{split.youWrite}</div>
    </div>
  </div>
</section>

<style>
  .split {
    max-width: 1240px;
    margin: 0 auto;
    padding: 96px 24px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 20px;
    margin-top: 48px;
  }
  .handles {
    border: 1.5px dashed var(--line-dashed);
    border-radius: 16px;
    padding: 28px;
  }
  .yours {
    background: var(--accent);
    border-radius: 16px;
    padding: 28px;
    display: flex;
    flex-direction: column;
  }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
  }
  .title {
    font-weight: 800;
    font-size: 22px;
  }
  .note {
    font-family: var(--font-mono);
    font-size: 12px;
  }
  .handles .note {
    color: var(--muted);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .chips span {
    padding: 7px 11px;
    background: var(--chip);
    border-radius: 8px;
  }
  .big {
    font-weight: 900;
    font-stretch: 112%;
    font-size: clamp(40px, 5vw, 60px);
    letter-spacing: -0.04em;
    line-height: 1;
    margin-top: 20px;
  }
  .text {
    font-size: 17px;
    line-height: 1.5;
    margin-top: auto;
    padding-top: 20px;
    max-width: 420px;
  }
</style>
