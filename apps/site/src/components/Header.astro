---
const links = [
  { href: "/#tools", label: "Tools" },
  { href: "/#fit", label: "How it fits" },
  { href: "/#start", label: "Get started" },
];
---

<header class="header">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label="keelstack home">keelstack</a>
    <nav aria-label="Sections">
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    border-bottom: 1px solid var(--border);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-top: 0.875rem;
    padding-bottom: 0.875rem;
  }
  .brand {
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--text);
    text-decoration: none;
    letter-spacing: -0.01em;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.9375rem;
    padding: 0.25rem 0;
  }
  nav a:hover {
    color: var(--text);
  }
</style>
