---
import { fitSteps } from "../data/tools";
---

<section id="fit" aria-labelledby="fit-title">
  <div class="wrap">
    <h2 id="fit-title">How they fit together</h2>
    <p class="section-lead">
      A template defines the repo, a tool renders it and keeps it current, and a cache keeps its CI
      fast.
    </p>
    <ol class="steps">
      {
        fitSteps.map((step, i) => (
          <li class="step">
            <span class="num" aria-hidden="true">
              {i + 1}
            </span>
            <h3>
              {step.title} <span class="by">with {step.tool}</span>
            </h3>
            <p>{step.body}</p>
            <code>{step.code}</code>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .steps {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 56rem) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .step {
    position: relative;
    border-left: 3px solid var(--accent);
    padding: 0.25rem 0 0.25rem 1.25rem;
  }
  .num {
    display: inline-grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 700;
    font-size: 0.875rem;
    margin-bottom: 0.5rem;
  }
  h3 {
    font-size: 1.125rem;
  }
  .by {
    font-weight: 400;
    color: var(--muted);
  }
  p {
    color: var(--muted);
  }
</style>
