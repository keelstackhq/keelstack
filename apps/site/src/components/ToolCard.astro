---
import { Badge } from "@cascivo/react";
import type { Tool } from "../data/tools";

interface Props {
  tool: Tool;
}
const { tool } = Astro.props;
---

<article class="card">
  <div class="top">
    <span class="role">{tool.role}</span>
    <Badge variant="outline" className={`status ${tool.statusStyle}`}>{tool.status}</Badge>
  </div>
  <h3 class="name">{tool.name}</h3>
  <p class="pitch">{tool.pitch}</p>
  <p class:list={["detail", { mono: tool.detailMono }]}>{tool.detail}</p>
  <a class="repo" href={tool.repo}>{tool.name} on GitHub →</a>
</article>

<style>
  .card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
  }
  .role {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }
  .card :global(.status) {
    font-family: var(--font-mono);
    font-size: 11px;
    padding: 4px 8px;
    border-radius: 99px;
    line-height: 1.6;
    white-space: nowrap;
    flex-shrink: 0;
    background: transparent;
    color: var(--ink);
    border: 1px solid var(--ink);
  }
  .card :global(.status.filled) {
    background: var(--ink);
    color: var(--accent);
  }
  .card :global(.status.dashed) {
    border-style: dashed;
  }
  .name {
    margin: 0;
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 34px;
    letter-spacing: -0.02em;
    line-height: 1.5;
  }
  .pitch {
    margin: 0;
    font-size: 17px;
    line-height: 1.5;
  }
  .detail {
    margin: 0;
    font-size: 14px;
    color: var(--muted);
    line-height: 1.6;
  }
  .detail.mono {
    font-family: var(--font-mono);
  }
  .repo {
    margin-top: auto;
    font-weight: 700;
  }
</style>
