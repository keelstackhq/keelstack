---
import { terminal } from "../data/content";
---

<div class="term" role="group" aria-label="splice new session, excerpt">
  <div class="bar">
    <span class="dot" aria-hidden="true"></span><span class="dot" aria-hidden="true"></span><span
      class="dot"
      aria-hidden="true"></span>
    <span class="title">{terminal.title}</span>
  </div>
  <div class="body">
    {
      terminal.command.map((line, i) => (
        <div class:list={{ indent: i > 0 }}>
          {i === 0 && <span class="g">$</span>}
          {i === 0 ? " " : ""}
          {line}
        </div>
      ))
    }
    <div class="gap"></div>
    {
      terminal.output.map((o) => (
        <div>
          <span class="g">create</span> {o.path} <span class="dim">{o.cls}</span>
        </div>
      ))
    }
    <div class="dim">{terminal.summary}</div>
    <div class="gap"></div>
    <div class="turn">{terminal.turn}</div>
  </div>
</div>

<style>
  .term {
    background: var(--ink);
    color: #e9e7e1;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 30px 60px -30px rgba(21, 22, 26, 0.45);
    font-family: var(--font-mono);
    font-size: 13.5px;
    line-height: 1.75;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--dark-line);
  }
  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #3a3c42;
  }
  .title {
    margin-left: 10px;
    color: #8b8d94;
    font-size: 12px;
  }
  .body {
    padding: 20px 22px 24px;
    display: grid;
    gap: 4px;
    overflow-wrap: anywhere;
  }
  .g {
    color: var(--accent);
  }
  .dim {
    color: #8b8d94;
  }
  .indent {
    padding-left: 18px;
  }
  .gap {
    height: 10px;
  }
  .turn {
    background: var(--accent);
    color: var(--ink);
    margin: 0 -22px;
    padding: 6px 22px;
    font-weight: 600;
  }
</style>
