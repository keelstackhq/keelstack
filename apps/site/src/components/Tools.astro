---
import { sections } from "../data/content";
import { tools } from "../data/tools";
import SectionHead from "./SectionHead.astro";
import ToolCard from "./ToolCard.astro";
---

<section id="tools" class="tools" aria-labelledby="tools-h">
  <SectionHead id="tools-h" label={sections.tools.label} heading={sections.tools.heading} />
  <div class="grid">
    {tools.map((tool) => <ToolCard tool={tool} />)}
  </div>
</section>

<style>
  .tools {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 24px 96px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 20px;
    margin-top: 48px;
  }
</style>
