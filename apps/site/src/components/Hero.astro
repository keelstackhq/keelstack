---
import { Button } from "@cascivo/react";
import { hero } from "../data/content";
import { org } from "../data/tools";
import HeroTerminal from "./HeroTerminal.astro";

const v = hero.variants[hero.active];
---

<header id="top" class="hero">
  <div>
    <div class="label eyebrow">{hero.eyebrow}</div>
    <h1>{v.lead}<span class="hl">{v.highlight}</span></h1>
    <p class="body">{hero.body}</p>
    <div class="ctas">
      <Button asChild><a class="btn btn-primary" href="/#start">Get started →</a></Button>
      <Button asChild>
        <a class="btn btn-outline" href={org.url}>keelstackhq on GitHub</a>
      </Button>
    </div>
  </div>
  <HeroTerminal />
</header>

<style>
  .hero {
    max-width: 1240px;
    margin: 0 auto;
    padding: 72px 24px 56px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 480px), 1fr));
    gap: 48px;
    align-items: center;
  }
  .eyebrow {
    margin-bottom: 20px;
  }
  h1 {
    margin: 0;
    font-weight: 900;
    font-stretch: 112%;
    font-size: clamp(48px, 7vw, 104px);
    line-height: 0.92;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }
  .hl {
    background: var(--accent);
    padding: 0 0.12em;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }
  .body {
    font-size: 20px;
    line-height: 1.5;
    color: var(--ink-2);
    max-width: 560px;
    margin: 28px 0 0;
  }
  .ctas {
    display: flex;
    gap: 12px;
    margin-top: 32px;
    flex-wrap: wrap;
  }
</style>
