---
import { current, sections, update } from "../data/content";
import SectionHead from "./SectionHead.astro";
---

<section class="current" aria-labelledby="current-h">
  <SectionHead
    id="current-h"
    label={sections.current.label}
    heading={sections.current.heading}
    maxWidth="900px"
  />
  <div class="grid">
    {
      current.map((c) => (
        <div class:list={["item", { accent: c.accent }]}>
          <div class="label kind">{c.label}</div>
          <div class="title">{c.title}</div>
          <div class="text">{c.text}</div>
        </div>
      ))
    }
  </div>
  <div class="updates">
    {
      [update.hull, update.bosun].map((p) => (
        <div class="update">
          <h3 class="update-h">{p.heading}</h3>
          <ol class="steps">
            {p.steps.map((s) => (
              <li>
                {s.cmd ? <code>{s.cmd}</code> : s.text}
                {s.cmd && s.note && <span class="note"> # {s.note}</span>}
              </li>
            ))}
          </ol>
          {p.notes.map((n) => (
            <p class="text">{n.replaceAll("`", "")}</p>
          ))}
        </div>
      ))
    }
    <p class="text"><a href={update.href}>Full update guide</a></p>
  </div>
</section>

<style>
  .current {
    max-width: 1240px;
    margin: 0 auto;
    padding: 96px 24px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 20px;
    margin-top: 48px;
  }
  .item {
    border-top: 3px solid var(--ink);
    padding-top: 20px;
  }
  .item.accent {
    border-top-color: var(--accent-ink);
  }
  .item.accent .kind {
    color: var(--accent-ink);
  }
  .title {
    font-weight: 800;
    font-size: 26px;
    margin-top: 6px;
    letter-spacing: -0.02em;
  }
  .text {
    color: var(--ink-2);
    margin-top: 8px;
    line-height: 1.5;
  }
  .updates {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 40px;
    margin-top: 56px;
  }
  .updates > .text {
    grid-column: 1 / -1;
    margin: 0;
  }
  .update-h {
    font-weight: 800;
    font-size: 20px;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .steps {
    margin: 16px 0 0;
    padding-left: 24px;
    line-height: 1.7;
  }
  .steps code {
    font-family: var(--mono, "JetBrains Mono", monospace);
    font-size: 14px;
    overflow-wrap: anywhere;
  }
  .note {
    color: var(--ink-2);
    font-size: 14px;
  }
</style>
