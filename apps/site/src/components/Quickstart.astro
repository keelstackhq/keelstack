---
import { quickstart as q } from "../data/content";
import SectionHead from "./SectionHead.astro";
---

<section id="quickstart" class="qs" aria-labelledby="qs-h">
  <div class="inner">
    <SectionHead id="qs-h" label={q.label} heading={q.heading} />
    <p class="intro">{q.body}</p>
    <div class="grid">
      <ol class="steps">
        {
          q.steps.map((s) => (
            <li>
              {s.cmd && <code class="cmd">{s.cmd}</code>}
              <span>{s.text}</span>
            </li>
          ))
        }
      </ol>
      <aside class="agents" aria-labelledby="qs-agents-h">
        <h3 id="qs-agents-h">{q.agents.heading}</h3>
        <p>{q.agents.body}</p>
        <p class="fields">
          {q.agents.fields.map((f) => <code>{f}</code>)}
        </p>
        <dl class="codes">
          {
            q.agents.exitCodes.map(([n, name]) => (
              <div>
                <dt>{n}</dt>
                <dd>{name}</dd>
              </div>
            ))
          }
        </dl>
      </aside>
    </div>
    <p class="more"><a href={q.more.href}>{q.more.label} →</a></p>
  </div>
</section>

<style>
  .qs {
    background: var(--surface);
    border-top: 1px solid var(--line);
  }
  .inner {
    max-width: 1240px;
    margin: 0 auto;
    padding: 96px 24px;
  }
  .intro {
    font-size: 17px;
    color: var(--ink-2);
    line-height: 1.5;
    max-width: 640px;
    margin: 16px 0 0;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 40px;
    margin-top: 40px;
    align-items: start;
  }
  .steps {
    margin: 0;
    padding: 0 0 0 28px;
    display: grid;
    gap: 16px;
  }
  .steps li {
    color: var(--ink-2);
    line-height: 1.5;
    padding-left: 4px;
  }
  .steps li::marker {
    font-family: var(--font-mono);
    color: var(--accent-ink);
    font-weight: 600;
  }
  .cmd {
    display: block;
    width: fit-content;
    max-width: 100%;
    overflow-wrap: anywhere;
    font-family: var(--font-mono);
    font-size: 14px;
    background: var(--ink);
    color: var(--paper);
    padding: 6px 10px;
    border-radius: 8px;
    margin-bottom: 6px;
  }
  .agents {
    background: var(--ink);
    color: var(--dark-text-2);
    border-radius: 16px;
    padding: 28px 24px;
  }
  .agents h3 {
    color: #fff;
    margin: 0 0 12px;
    font-size: 20px;
  }
  .agents p {
    margin: 0 0 16px;
    line-height: 1.5;
  }
  .fields {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .fields code {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--accent);
    border: 1px solid var(--dark-line);
    border-radius: 6px;
    padding: 2px 8px;
  }
  .codes {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
    gap: 8px 16px;
    margin: 0;
  }
  .codes div {
    display: flex;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 14px;
  }
  .codes dt {
    color: var(--accent);
  }
  .codes dd {
    margin: 0;
  }
  .note {
    font-size: 14px;
    color: var(--muted);
    max-width: 640px;
    margin: 32px 0 0;
  }
  .more {
    margin: 12px 0 0;
    font-weight: 600;
  }
  .more a {
    color: var(--ink);
  }
</style>
