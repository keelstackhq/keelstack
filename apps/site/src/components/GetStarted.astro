---
import { quickStart, spliceStart } from "../data/tools";
---

<section id="start" aria-labelledby="start-title">
  <div class="wrap">
    <h2 id="start-title">Get started</h2>
    <p class="section-lead">
      splice is not released yet, so today you render with hull's dev renderer. It needs Node 24
      and pnpm 12; run <code>pnpm install</code> once in a hull checkout.
    </p>
    <figure class="snippet">
      <figcaption>
        <span>In a hull checkout</span>
      </figcaption>
      <pre tabindex="0"><code>{quickStart}</code></pre>
    </figure>
    <p class="later">
      When splice 0.1 is out, the equivalent is <code>{spliceStart}</code> (flags unconfirmed).
    </p>
  </div>
</section>

<style>
  .snippet {
    margin: 1.5rem 0 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--code-bg);
    overflow: hidden;
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem 0.5rem 1rem;
    border-bottom: 1px solid var(--border);
    font-size: 0.875rem;
    color: var(--muted);
    min-height: 3rem;
  }
  pre {
    margin: 0;
    padding: 1rem;
    overflow-x: auto;
    line-height: 1.7;
  }
  .later {
    color: var(--muted);
    font-size: 0.9375rem;
  }
</style>
