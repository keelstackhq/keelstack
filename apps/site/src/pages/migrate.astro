---
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import { migrate, QUICKSTART_URL, RUNBOOK_URL } from "../data/migrate";
import Base from "../layouts/Base.astro";
import "../styles/docs.css";

const { local, web, slack } = migrate;
---

<Base title={`${migrate.title} · keelstack`} description={migrate.summary}>
  <Nav />
  <main id="main" class="prose migrate">
    <h1>{migrate.title}</h1>
    <p>{migrate.forWho}</p>
    <p>{migrate.owner}</p>
    <p>
      Full runbook: <a href={RUNBOOK_URL}><code>docs/migrate-booster.md</code></a> in bosun. Setup and the
      steps for steady: <a href={QUICKSTART_URL}><code>docs/quickstart.md</code></a>.
    </p>
    <nav aria-label="On this page">
      <ul>
        <li><a href="#changes">What booster changes</a></li>
        <li><a href="#steps">The steps</a></li>
        <li><a href="#local">{local.heading}</a></li>
        <li><a href="#web">{web.heading}</a></li>
        <li><a href="#slack">{slack.heading}</a></li>
      </ul>
    </nav>

    <h2 id="changes">What booster changes</h2>
    <table tabindex="0">
      <thead>
        <tr>{migrate.knobHead.map((h) => <th>{h}</th>)}</tr>
      </thead>
      <tbody>
        {migrate.knobs.map((row) => (
          <tr>
            <td><code>{row[0]}</code></td>
            <td><code>{row[1]}</code></td>
            <td><code>{row[2]}</code></td>
            <td>{row[3]}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p>{migrate.fastLane}</p>

    <h2 id="steps">The steps</h2>
    <p>The same in every environment. One PR per step.</p>
    <ol>
      {migrate.steps.map(([name, text]) => <li><strong>{name}.</strong> {text}</li>)}
    </ol>
    <p>{migrate.stepsAfter}</p>

    <h2 id="local">{local.heading}</h2>
    <p>{local.intro}</p>
    <pre><code>{local.setup}</code></pre>
    <ul>{local.notes.map((n) => <li>{n}</li>)}</ul>
    <p>{local.gatesLabel}</p>
    <pre><code>{local.gates}</code></pre>
    <h3>Prompt for Claude</h3>
    <pre><code>{local.prompt}</code></pre>

    <h2 id="web">{web.heading}</h2>
    <p>{web.intro}</p>
    <p>{web.setupLabel}</p>
    <pre><code>{web.setup}</code></pre>
    <p>{web.setupNote} The script is on <a href="/docs/cloud/">the Cloud environment page</a>.</p>
    <p>{web.network}</p>
    <ul>{web.hosts.map(([host, why]) => <li><code>{host}</code>: {why}</li>)}</ul>
    <p>{web.hostsNote}</p>
    <p>{web.env}</p>
    <p>{web.cloud}</p>
    <pre><code>{web.cloudToml}</code></pre>
    <p>{web.cloudNote} {web.janitor}</p>
    <p>What a cloud session cannot do:</p>
    <ul>{web.cannot.map((n) => <li>{n}</li>)}</ul>
    <h3>Prompt for Claude</h3>
    <pre><code>{web.prompt}</code></pre>

    <h2 id="slack">{slack.heading}</h2>
    <p>{slack.intro}</p>
    <pre><code>{slack.toml}</code></pre>
    <p>{slack.tomlNote} {slack.session}</p>
    <pre><code>{slack.commands}</code></pre>
    <ul>{slack.notes.map((n) => <li>{n}</li>)}</ul>
    <h3>Prompt for Claude</h3>
    <pre><code>{slack.prompt}</code></pre>

    <p class="docs-foot">
      Source: <a href={RUNBOOK_URL}>bosun <code>docs/migrate-booster.md</code></a> · <a href="/">keelstack</a>
    </p>
  </main>
  <Footer />
</Base>

<style>
  .migrate {
    max-width: 72ch;
    margin: 0 auto;
    padding: 48px 24px 64px;
  }
</style>
