---
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import { APPENDIX_URL, migrate, QUICKSTART_URL, RUNBOOK_URL } from "../data/migrate";
import Base from "../layouts/Base.astro";
import "../styles/docs.css";

const { local, web, slack, quick, does } = migrate;
---

<Base title={`${migrate.title} · keelstack`} description={migrate.summary}>
  <Nav />
  <main id="main" class="prose migrate">
    <h1>{migrate.title}</h1>
    <p>{migrate.forWho}</p>
    <p>{migrate.owner}</p>
    <nav aria-label="On this page">
      <ul>
        <li><a href="#quick">Quick start</a></li>
        <li><a href="#does">What bosun migrate does</a></li>
        <li><a href="#local">{local.heading}</a></li>
        <li><a href="#web">{web.heading}</a></li>
        <li><a href="#slack">{slack.heading}</a></li>
        <li><a href="#changes">What booster changes</a></li>
        <li><a href="#manual">The manual path</a></li>
      </ul>
    </nav>

    <h2 id="quick">Quick start</h2>
    <p>{quick.setupLabel}</p>
    <pre><code>{quick.setup}</code></pre>
    <p>{quick.setupNote}</p>
    <p>{quick.network}</p>
    <p>{quick.promptLabel}</p>
    <pre><code>{quick.prompt}</code></pre>
    <p>{quick.promptNote}</p>
    <p>{quick.approve}</p>

    <h2 id="does">What bosun migrate does</h2>
    <p>{does.intro}</p>
    <pre><code>{does.commands}</code></pre>
    <ul>{does.notes.map((n) => <li>{n}</li>)}</ul>

    <h2 id="local">{local.heading}</h2>
    <ol>{local.steps.map((n) => <li>{n}</li>)}</ol>

    <h2 id="web">{web.heading}</h2>
    <ol>{web.steps.map((n) => <li>{n}</li>)}</ol>
    <p>The script is on <a href="/docs/cloud/">the Cloud environment page</a>.</p>

    <h2 id="slack">{slack.heading}</h2>
    <ol>{slack.steps.map((n) => <li>{n}</li>)}</ol>

    <h2 id="changes">What booster changes</h2>
    <table tabindex="0">
      <thead>
        <tr>{migrate.knobHead.map((h) => <th>{h}</th>)}</tr>
      </thead>
      <tbody>
        {migrate.knobs.map((row) => (
          <tr>
            <td><code>{row[0]}</code></td>
            <td><code>{row[1]}</code></td>
            <td><code>{row[2]}</code></td>
            <td>{row[3]}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p>{migrate.fastLane}</p>

    <h2 id="manual">The manual path</h2>
    <p>
      For a release without <code>bosun migrate</code>, or when a step needs a hand, the long path is
      <a href={APPENDIX_URL}>Appendix A of the guide</a>. Full guide: <a href={RUNBOOK_URL}><code>docs/migrate-booster.md</code></a>.
      Setup: <a href={QUICKSTART_URL}><code>docs/quickstart.md</code></a>.
    </p>

    <p class="docs-foot">
      Source: <a href={RUNBOOK_URL}>bosun <code>docs/migrate-booster.md</code></a> · <a href="/">keelstack</a>
    </p>
  </main>
  <Footer />
</Base>

<style>
  .migrate {
    max-width: 72ch;
    margin: 0 auto;
    padding: 48px 24px 64px;
  }
</style>
