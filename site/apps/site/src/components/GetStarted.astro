---
import { sections } from "../data/content";
import PiecePicker from "./PiecePicker";
import SectionHead from "./SectionHead.astro";

// Render `pnpm install` as inline code; the copy itself stays verbatim in content.ts.
const [before, after = ""] = (sections.start.body ?? "").split("pnpm install");
---

<section id="start" class="start" aria-labelledby="start-h">
  <div class="inner">
    <SectionHead id="start-h" label={sections.start.label} heading={sections.start.heading} />
    <p class="intro">{before}<code>pnpm install</code>{after}</p>
    <PiecePicker client:visible />
    <ul class="next">
      {
        sections.start.links?.map((l) => (
          <li>
            <a href={l.href}>{l.label}</a>
            <span>{l.text}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .start {
    background: var(--surface);
    border-top: 1px solid var(--line);
  }
  .inner {
    max-width: 1240px;
    margin: 0 auto;
    padding: 96px 24px;
  }
  @media (max-width: 640px) {
    .inner {
      padding: 48px 24px 64px;
    }
  }
  .intro {
    font-size: 17px;
    color: var(--ink-2);
    line-height: 1.5;
    max-width: 640px;
    margin: 16px 0 0;
  }
  .next {
    list-style: none;
    padding: 0;
    margin: 40px 0 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px 32px;
    font-size: 15px;
    color: var(--ink-2);
    line-height: 1.5;
  }
  @media (min-width: 760px) {
    .next {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .next li {
    border-top: 1px solid var(--line);
    padding-top: 12px;
    display: grid;
    align-content: start;
    gap: 4px;
  }
  .next a {
    color: var(--ink);
    font-weight: 700;
    font-size: 16px;
  }
  .intro code {
    white-space: nowrap;
  }
  code {
    font-family: var(--font-mono);
    background: var(--chip);
    padding: 2px 6px;
    border-radius: 5px;
  }
</style>
