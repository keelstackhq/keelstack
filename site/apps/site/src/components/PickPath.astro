---
import { pickPath } from "../data/content";
import SectionHead from "./SectionHead.astro";
---

<section class="pick" aria-labelledby="pick-h">
  <SectionHead id="pick-h" label={pickPath.label} heading={pickPath.heading} maxWidth="900px" />
  <ul class="grid">
    {
      pickPath.cards.map((c) => (
        <li class="card">
          <a href={c.href}>
            <span class="label kind">{c.id.toUpperCase()}</span>
            <span class="title">{c.title}</span>
            <span class="text">{c.summary}</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .pick {
    max-width: 1240px;
    margin: 0 auto;
    padding: 72px 24px 24px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 20px;
    margin: 40px 0 0;
    padding: 0;
    list-style: none;
  }
  .card a {
    display: block;
    height: 100%;
    border-top: 3px solid var(--ink);
    padding-top: 16px;
    color: inherit;
    text-decoration: none;
  }
  .card a:hover .title,
  .card a:focus-visible .title {
    text-decoration: underline;
  }
  .kind {
    display: block;
    color: var(--accent-ink);
  }
  .title {
    display: block;
    font-weight: 800;
    font-size: 24px;
    margin-top: 6px;
    letter-spacing: -0.02em;
  }
  .text {
    display: block;
    color: var(--ink-2);
    margin-top: 8px;
    line-height: 1.5;
  }
</style>
