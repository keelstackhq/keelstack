---
import { pickPath } from "../data/content";
import SectionHead from "./SectionHead.astro";
---

<section class="pick" aria-labelledby="pick-h">
  <SectionHead id="pick-h" label={pickPath.label} heading={pickPath.heading} maxWidth="900px" />
  <ul class="grid">
    {
      pickPath.cards.map((c) => (
        <li class="card">
          <a href={c.href}>
            <span class="label kind">{c.id.toUpperCase()}</span>
            <span class="title">{c.title}<span class="go" aria-hidden="true">→</span></span>
            <span class="text">{c.summary}</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .pick {
    max-width: 1240px;
    margin: 0 auto;
    padding: 72px 24px 24px;
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px 24px;
    margin: 40px 0 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 600px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 960px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .card a {
    display: block;
    height: 100%;
    border-top: 3px solid var(--ink);
    padding: 16px 0 4px;
    color: inherit;
    text-decoration: none;
  }
  .card a:hover .title,
  .card a:focus-visible .title {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .card a:hover,
  .card a:focus-visible {
    border-top-color: var(--accent-ink);
  }
  .go {
    display: inline-block;
    margin-left: 0.3em;
    color: var(--accent-ink);
    transition: transform 0.15s ease;
  }
  .card a:hover .go,
  .card a:focus-visible .go {
    transform: translateX(4px);
  }
  @media (prefers-reduced-motion: reduce) {
    .go {
      transition: none;
    }
  }
  .kind {
    display: block;
    color: var(--accent-ink);
  }
  .title {
    display: block;
    font-weight: 800;
    font-size: 24px;
    margin-top: 6px;
    letter-spacing: -0.02em;
  }
  .text {
    display: block;
    color: var(--ink-2);
    margin-top: 8px;
    line-height: 1.5;
  }
</style>
